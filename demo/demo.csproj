<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only include SteamWebAPI2 when not exporting (editor only) -->
    <PackageReference Include="SteamWebAPI2" Version="4.4.1" Condition="'$(Configuration)' != 'ExportRelease' And '$(Configuration)' != 'ExportDebug'" />
    <PackageReference Include="Steamworks.NET.AnyCPU" Version="2025.162.6-anycpu021" />
  </ItemGroup>
</Project>